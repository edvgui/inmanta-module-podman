[Pod]
{{- "PodName" | files.systemd_unit.directive(pod.name) }}
{{- "HostName" | files.systemd_unit.directive(pod.hostname) }}
{#- Index the dict instead of using items(), to get null values converted to none -#}
{%- for k in pod.labels %}
{{- "Label" | files.systemd_unit.directive(k ~ ("=" ~ pod.labels[k] if pod.labels[k] is not none else "")) }}
{%- endfor %}
{{- "UserNS" | files.systemd_unit.directive(pod.userns) }}
{{- "SubUIDMap" | files.systemd_unit.directive(pod.sub_uid_map) }}
{{- "SubGIDMap" | files.systemd_unit.directive(pod.sub_gid_map) }}
{{- "ContainersConfModule" | files.systemd_unit.directive(pod.containers_conf_module) }}
{%- for arg in pod.global_args %}
{{- "GlobalArgs" | files.systemd_unit.directive(arg | files.systemd_unit.quote()) }}
{%- endfor %}
{{- "DNS" | files.systemd_unit.directive(pod.dns) }}
{{- "DNSSearch" | files.systemd_unit.directive(pod.dns_search) }}
{{- "DNSOption" | files.systemd_unit.directive(pod.dns_option) }}
{{- "IP" | files.systemd_unit.directive(pod.ip) }}
{{- "IP6" | files.systemd_unit.directive(pod.ip6) }}
{{- "ShmSize" | files.systemd_unit.directive(pod.shm_size) }}
{{- "ExitPolicy" | files.systemd_unit.directive(pod.exit_policy) }}
{%- for volume in pod.volumes %}
{{- "Volume" | files.systemd_unit.directive(volume.cli_option) }}
{%- endfor %}
{%- for network in pod.networks %}
{{- "Network" | files.systemd_unit.directive(network.cli_option) }}
{%- endfor %}
{{- "NetworkAlias" | files.systemd_unit.directive(pod.network_alias) }}
{%- for host in pod.hosts %}
{{- "AddHost" | files.systemd_unit.directive(host.cli_option) }}
{%- endfor %}
{%- for publish in pod.publish %}
{{- "PublishPort" | files.systemd_unit.directive(publish.cli_option) }}
{%- endfor %}
{%- for uidmap in pod.uidmap %}
{{- "UIDMap" | files.systemd_unit.directive(uidmap.cli_option) }}
{%- endfor %}
{%- for gidmap in pod.gidmap %}
{{- "GIDMap" | files.systemd_unit.directive(gidmap.cli_option) }}
{%- endfor %}
{{- "PodmanArgs" | files.systemd_unit.directive("--no-hosts" if pod.no_hosts else none) }}
{%- for arg in pod.extra_args %}
{%- if arg.cmd == "podman-pod-create" %}
{{- "PodmanArgs" | files.systemd_unit.directive(("--" + arg.name + "=" + arg.value if arg.value is not none else "") | files.systemd_unit.quote()) }}
{%- endif %}
{%- endfor %}
{%- for arg in pod.podman_args %}
{{- "PodmanArgs" | files.systemd_unit.directive(arg | files.systemd_unit.quote()) }}
{%- endfor %}
