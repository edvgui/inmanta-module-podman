[Container]
{{- "ContainerName" | files.systemd_unit.directive(container.name) }}
{{- "Image" | files.systemd_unit.directive(container.image) }}
{{- "HostName" | files.systemd_unit.directive(container.hostname) }}
{#- Index the dicts instead of using items(), to get null values converted to none -#}
{%- for k in container.labels %}
{{- "Label" | files.systemd_unit.directive(k ~ ("=" ~ container.labels[k] if container.labels[k] is not none else "")) }}
{%- endfor %}
{%- for k in container.annotations %}
{{- "Annotation" | files.systemd_unit.directive(k ~ ("=" ~ container.annotations[k] if container.annotations[k] is not none else "")) }}
{%- endfor %}
{{- "UserNS" | files.systemd_unit.directive(container.userns) }}
{{- "SubUIDMap" | files.systemd_unit.directive(container.sub_uid_map) }}
{{- "SubGIDMap" | files.systemd_unit.directive(container.sub_gid_map) }}
{{- "ContainersConfModule" | files.systemd_unit.directive(container.containers_conf_module) }}
{%- for arg in container.global_args %}
{{- "GlobalArgs" | files.systemd_unit.directive(arg | files.systemd_unit.quote()) }}
{%- endfor %}
{{- "DNS" | files.systemd_unit.directive(container.dns) }}
{{- "DNSSearch" | files.systemd_unit.directive(container.dns_search) }}
{{- "DNSOption" | files.systemd_unit.directive(container.dns_option) }}
{{- "IP" | files.systemd_unit.directive(container.ip) }}
{{- "IP6" | files.systemd_unit.directive(container.ip6) }}
{{- "ShmSize" | files.systemd_unit.directive(container.shm_size) }}
{%- for name in container.env %}
{{- "Environment" | files.systemd_unit.directive(name | files.systemd_unit.environment(container.env[name])) }}
{%- endfor %}
{{- "EnvironmentFile" | files.systemd_unit.directive(container.env_file) }}
{{- "EnvironmentHost" | files.systemd_unit.directive(container.environment_host or none) }}
{{- "Entrypoint" | files.systemd_unit.directive(container.entrypoint) }}
{{- "Exec" | files.systemd_unit.directive(container.command) }}
{{- "User" | files.systemd_unit.directive(container.user) }}
{{- "Group" | files.systemd_unit.directive(container.group) }}
{{- "GroupAdd" | files.systemd_unit.directive(container.group_add) }}
{{- "WorkingDir" | files.systemd_unit.directive(container.working_dir) }}
{%- for volume in container.volumes %}
{{- "Volume" | files.systemd_unit.directive(volume.cli_option) }}
{%- endfor %}
{{- "Mount" | files.systemd_unit.directive(container.mount) }}
{{- "Tmpfs" | files.systemd_unit.directive(container.tmpfs) }}
{{- "ReadOnly" | files.systemd_unit.directive(container.read_only or none) }}
{{- "ReadOnlyTmpfs" | files.systemd_unit.directive(container.read_only_tmpfs) }}
{{- "AddDevice" | files.systemd_unit.directive(container.add_device) }}
{{- "AddCapability" | files.systemd_unit.directive(container.add_capability) }}
{{- "DropCapability" | files.systemd_unit.directive(container.drop_capability) }}
{{- "ExposeHostPort" | files.systemd_unit.directive(container.expose_host_port) }}
{{- "Memory" | files.systemd_unit.directive(container.memory) }}
{{- "PidsLimit" | files.systemd_unit.directive(container.pids_limit) }}
{{- "Ulimit" | files.systemd_unit.directive(container.ulimit) }}
{{- "CgroupsMode" | files.systemd_unit.directive(container.cgroups_mode) }}
{{- "LogDriver" | files.systemd_unit.directive(container.log_driver) }}
{{- "LogOpt" | files.systemd_unit.directive(container.log_opt) }}
{{- "Pull" | files.systemd_unit.directive(container.pull) }}
{{- "RunInit" | files.systemd_unit.directive(container.run_init or none) }}
{{- "StopSignal" | files.systemd_unit.directive(container.stop_signal) }}
{{- "StopTimeout" | files.systemd_unit.directive(container.stop_timeout) }}
{{- "TimeZone" | files.systemd_unit.directive(container.timezone) }}
{%- if container.health is defined %}
{%- set health = container.health %}
{{- "HealthCmd" | files.systemd_unit.directive(health.cmd | files.systemd_unit.quote() if health.cmd is not none else none) }}
{{- "HealthInterval" | files.systemd_unit.directive(health.interval) }}
{{- "HealthRetries" | files.systemd_unit.directive(health.retries) }}
{{- "HealthTimeout" | files.systemd_unit.directive(health.timeout) }}
{{- "HealthStartPeriod" | files.systemd_unit.directive(health.start_period) }}
{{- "HealthStartupCmd" | files.systemd_unit.directive(health.startup_cmd | files.systemd_unit.quote() if health.startup_cmd is not none else none) }}
{{- "HealthStartupInterval" | files.systemd_unit.directive(health.startup_interval) }}
{{- "HealthStartupRetries" | files.systemd_unit.directive(health.startup_retries) }}
{{- "HealthStartupSuccess" | files.systemd_unit.directive(health.startup_success) }}
{{- "HealthStartupTimeout" | files.systemd_unit.directive(health.startup_timeout) }}
{{- "HealthLogDestination" | files.systemd_unit.directive(health.log_destination) }}
{{- "HealthMaxLogCount" | files.systemd_unit.directive(health.max_log_count) }}
{{- "HealthMaxLogSize" | files.systemd_unit.directive(health.max_log_size) }}
{{- "HealthOnFailure" | files.systemd_unit.directive(health.on_failure) }}
{%- endif %}
{{- "Notify" | files.systemd_unit.directive(container.notify) }}
{{- "AutoUpdate" | files.systemd_unit.directive(container.auto_update) }}
{%- if container.pod is defined %}
{{- "Pod" | files.systemd_unit.directive(container.pod.name ~ ".pod") }}
{%- endif %}
{{- "StartWithPod" | files.systemd_unit.directive(container.start_with_pod) }}
{%- for network in container.networks %}
{{- "Network" | files.systemd_unit.directive(network.cli_option) }}
{%- endfor %}
{{- "NetworkAlias" | files.systemd_unit.directive(container.network_alias) }}
{%- for host in container.hosts %}
{{- "AddHost" | files.systemd_unit.directive(host.cli_option) }}
{%- endfor %}
{%- for publish in container.publish %}
{{- "PublishPort" | files.systemd_unit.directive(publish.cli_option) }}
{%- endfor %}
{%- for uidmap in container.uidmap %}
{{- "UIDMap" | files.systemd_unit.directive(uidmap.cli_option) }}
{%- endfor %}
{%- for gidmap in container.gidmap %}
{{- "GIDMap" | files.systemd_unit.directive(gidmap.cli_option) }}
{%- endfor %}
{{- "PodmanArgs" | files.systemd_unit.directive("--no-hosts" if container.no_hosts else none) }}
{%- if container.security_label is defined %}
{%- set security_label = container.security_label %}
{{- "SecurityLabelDisable" | files.systemd_unit.directive(security_label.disable or none) }}
{{- "SecurityLabelType" | files.systemd_unit.directive(security_label.type) }}
{{- "SecurityLabelLevel" | files.systemd_unit.directive(security_label.level) }}
{{- "SecurityLabelFileType" | files.systemd_unit.directive(security_label.file_type) }}
{{- "SecurityLabelNested" | files.systemd_unit.directive(security_label.nested or none) }}
{%- endif %}
{{- "SeccompProfile" | files.systemd_unit.directive(container.seccomp_profile) }}
{{- "Mask" | files.systemd_unit.directive(container.mask) }}
{{- "Unmask" | files.systemd_unit.directive(container.unmask) }}
{{- "NoNewPrivileges" | files.systemd_unit.directive(container.no_new_privileges or none) }}
{%- for k in container.sysctl %}
{{- "Sysctl" | files.systemd_unit.directive(k ~ "=" ~ container.sysctl[k]) }}
{%- endfor %}
{{- "Rootfs" | files.systemd_unit.directive(container.rootfs) }}
{{- "HttpProxy" | files.systemd_unit.directive(container.http_proxy) }}
{{- "Retry" | files.systemd_unit.directive(container.retry) }}
{{- "RetryDelay" | files.systemd_unit.directive(container.retry_delay) }}
{%- for arg in container.extra_args %}
{%- if arg.cmd == "podman-run" %}
{{- "PodmanArgs" | files.systemd_unit.directive(("--" + arg.name + "=" + arg.value if arg.value is not none else "") | files.systemd_unit.quote()) }}
{%- endif %}
{%- endfor %}
{%- for arg in container.podman_args %}
{{- "PodmanArgs" | files.systemd_unit.directive(arg | files.systemd_unit.quote()) }}
{%- endfor %}
